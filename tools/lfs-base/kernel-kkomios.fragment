# KkomiOS 커널 설정 조각 (make defconfig 위에 덮어씀)
# 만드는 법: tools/lfs-base/make-kernel-config.sh <리눅스 소스 폴더>
# =y 는 커널에 넣음, =m 은 모듈, =n 은 끔

# ---- 이름 ----
CONFIG_LOCALVERSION="-kkomios"
CONFIG_LOCALVERSION_AUTO=n

# ---- LFS 13.1 책 10.3 (systemd) 필수 항목 ----
CONFIG_WERROR=n
CONFIG_PSI=y
CONFIG_PSI_DEFAULT_DISABLED=n
CONFIG_IKHEADERS=n
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_RT_GROUP_SCHED=n
CONFIG_EXPERT=n
CONFIG_RELOCATABLE=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_UEVENT_HELPER=n
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM=y
CONFIG_DRM_PANIC=y
CONFIG_DRM_PANIC_SCREEN="kmsg"
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_FW_LOADER_USER_HELPER=n
CONFIG_DMIID=y
CONFIG_INOTIFY_USER=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_LEGACY_TIOCSTI=n
CONFIG_TTY=y
# 64비트 추가 항목
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_IRQ_REMAP=y
CONFIG_X86_X2APIC=y

# ---- VirtualBox 가상 머신 ----
# 디스크: SATA(AHCI) 컨트롤러, 루트는 ext4 (initramfs 없이 부팅하므로 =y)
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_BLK_DEV_SD=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
# 그래픽: VMSVGA(기본값) = vmwgfx, VBoxSVGA/VBoxVGA = vboxvideo
CONFIG_DRM_VMWGFX=y
CONFIG_DRM_VBOXVIDEO=y
CONFIG_DRM_BOCHS=m
# 게스트 기능(공유 폴더, 클립보드·화면 크기 조절은 나중에 게스트 확장 도구가 사용)
CONFIG_VIRT_DRIVERS=y
CONFIG_VBOXGUEST=y
CONFIG_VBOXSF_FS=m
# 네트워크: Intel PRO/1000(기본값), virtio-net
CONFIG_E1000=y
CONFIG_E1000E=m
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
# 소리: Intel HD Audio(기본값), AC97
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_INTEL8X0=m
# 입력: USB 태블릿 마우스, PS/2
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_MOUSE_PS2=y
# 가상 머신 안에서 커널이 하이퍼바이저를 알아보게
CONFIG_HYPERVISOR_GUEST=y
CONFIG_KVM_GUEST=y
CONFIG_PARAVIRT=y

# ---- 0.1 에 있던 것 (라이브 USB·RAID·나중의 실제 노트북용) ----
CONFIG_SQUASHFS=m
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=m
CONFIG_ISO9660_FS=m
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_MD=y
CONFIG_BLK_DEV_MD=m
CONFIG_MD_RAID0=m
CONFIG_MD_RAID1=m
CONFIG_MD_RAID10=m
CONFIG_MD_RAID456=m
CONFIG_BLK_DEV_DM=m
CONFIG_DM_CRYPT=m
CONFIG_VFAT_FS=m
CONFIG_NLS_CODEPAGE_437=m
CONFIG_NLS_ISO8859_1=m
CONFIG_NLS_UTF8=m
CONFIG_FUSE_FS=m
CONFIG_USER_NS=y
CONFIG_BLK_DEV_NVME=y
# 노트북(씽크패드 E14 G7) 드라이버: 모듈로만, 펌웨어는 나중에
CONFIG_DRM_XE=m
CONFIG_DRM_I915=m
CONFIG_WLAN=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_BT=m
CONFIG_BT_HCIBTUSB=m
CONFIG_SND_SOC=m
CONFIG_SND_SOC_SOF_TOPLEVEL=y
CONFIG_SND_SOC_SOF_PCI=m
CONFIG_SND_SOC_SOF_INTEL_TOPLEVEL=y
CONFIG_SND_SOC_SOF_LUNARLAKE=m
CONFIG_THINKPAD_ACPI=m
CONFIG_HID_MULTITOUCH=m
CONFIG_I2C_HID_ACPI=m
